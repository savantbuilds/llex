__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
myenv/

# Test / type / coverage artifacts
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/

# ---------------------------------------------------------------------------
# Node / frontend build artifacts
#
# llex/static/editor.bundle.js is generated from llex/static/js/** by esbuild.
# It is intentionally NOT tracked: committing an 800 kB build artifact lets the
# shipped bundle silently drift away from its source. Run `npm ci && npm run
# build` (see CONTRIBUTING.md) and the release workflow bundles it into the
# published wheel.
# ---------------------------------------------------------------------------
node_modules/
llex/static/editor.bundle.js
llex/static/editor.bundle.js.map

# ---------------------------------------------------------------------------
# Editors & OS
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Secrets / local environment
# ---------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example

# ---------------------------------------------------------------------------
# LLex artifacts
# ---------------------------------------------------------------------------
# Documents are user data, never source. Sample fixtures live in tests/ and are
# tracked explicitly.
*.llex
!tests/fixtures/*.llex

# Scratch prototypes and one-off codemods (historical experiment dumps)
scratch/
