    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-text-align": "^3.22.1",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/extension-underline": "^3.22.1",
    "@tiptap/pm": "^3.22.1",
    "@tiptap/starter-kit": "^3.22.1"
  },
  "devDependencies": {
    "esbuild": "^0.27.5",
    "jsdom": "^26.1.0"
  }
}
