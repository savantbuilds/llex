{
  "name": "llex",
  "version": "0.2.0",
  "private": true,
  "description": "Editor front end for LLex: a local-first, paginated word processor.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs --production",
